# ==============================================================================
#  tutorsync — пример конфигурации
#  Скопируй в .env и заполни. Порядок блоков совпадает с чеклистом в README.
#  Ничего из этого файла с реальными значениями в git не попадает (.gitignore).
# ==============================================================================

# ------------------------------------------------------------------------------
#  Процесс
# ------------------------------------------------------------------------------
# Какую роль выполняет контейнер: bot | web | worker.
# Образ один и тот же, различается только этой переменной — так удобнее в Coolify.
ROLE=worker

# Часовой пояс репетитора. Всё в БД хранится в UTC, это только для отображения.
OWNER_TZ=Europe/Rome

# debug | info | warning | error
LOG_LEVEL=info
# json — для прода (структурные логи), console — для локальной разработки
LOG_FORMAT=json

# ------------------------------------------------------------------------------
#  База данных
# ------------------------------------------------------------------------------
# Прод (Postgres 16+). Драйвер asyncpg обязателен.
DATABASE_URL=postgresql+asyncpg://tutorsync:CHANGE_ME@postgres:5432/tutorsync
# Локальная разработка (см. раздел «Ограничения» в README — на SQLite защита
# от пересечений интервалов работает через блокировку транзакции, а не через
# EXCLUDE-констрейнт, поэтому тесты на конфликты гоняются только на Postgres):
# DATABASE_URL=sqlite+aiosqlite:///./tutorsync.sqlite3

# ------------------------------------------------------------------------------
#  Шифрование
# ------------------------------------------------------------------------------
# Fernet-ключ, которым шифруется Google refresh-токен в БД. Сгенерировать:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ВНИМАНИЕ: смена ключа делает сохранённый токен нечитаемым — придётся заново
# пройти OAuth. Держи его в бэкапе отдельно от базы.
SECRET_ENC_KEY=

# ------------------------------------------------------------------------------
#  Telegram
# ------------------------------------------------------------------------------
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=
# Твой числовой Telegram user ID (узнать: @userinfobot). Можно несколько через запятую.
# Только эти ID видят админ-команды, очередь ручных задач и алерты.
ADMIN_TELEGRAM_IDS=
# Языки, которые ученик может выбрать на /start. Первый — по умолчанию.
STUDENT_LANGUAGES=ru,en

# ------------------------------------------------------------------------------
#  Публичный адрес (Cloudflare Tunnel → сервис web, порт 8080)
# ------------------------------------------------------------------------------
PUBLIC_BASE_URL=https://tutorsync.example.com
# Порт, который слушает процесс web внутри контейнера
WEB_PORT=8080

# ------------------------------------------------------------------------------
#  Google Calendar
# ------------------------------------------------------------------------------
# Credentials → OAuth client ID → тип Web application.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Должен быть в точности прописан в Authorized redirect URIs у OAuth-клиента.
GOOGLE_OAUTH_REDIRECT_URI=https://tutorsync.example.com/oauth/callback

# Calendar ID трёх календарей: Settings → календарь → Integrate calendar → Calendar ID
GCAL_CALENDAR_PREPLY=
GCAL_CALENDAR_PRIVATE=
GCAL_CALENDAR_BUFFERS=

# Дополнительные календари, занятость которых вычитается из свободных слотов,
# но в которые сервис ничего не пишет (личные дела, врач, поездки).
# Через запятую; primary — это твой основной календарь.
EXTRA_BUSY_CALENDAR_IDS=

# Как реагировать на изменения, сделанные в Google Calendar руками:
#   detect — БД остаётся источником истины: сервис восстанавливает своё событие
#            и присылает алерт (по умолчанию);
#   import — событие, созданное вручную в календаре Private, импортируется как урок,
#            ручное удаление трактуется как отмена.
# Считать ли занятостью события на весь день из читаемых календарей.
# false — не считать: дни рождения и праздники иначе закрыли бы сутки целиком,
# а отпуск задаётся отдельно, через /vacation, где у него есть точные границы.
BUSY_INCLUDE_ALL_DAY=false
# Насколько суток назад тянуть чужую занятость: урок, начавшийся вчера вечером
# и идущий за полночь, должен остаться виден.
BUSY_IMPORT_PAST_DAYS=1
# Как часто перечитывать читаемые календари. Это же и окно устаревания:
# бронь, появившаяся на Preply, станет видна боту не позже чем через столько минут.
BUSY_IMPORT_INTERVAL_MIN=5

GCAL_INBOUND_MODE=detect

# Секрет, который Google возвращает в заголовке X-Goog-Channel-Token push-уведомления.
# Google свои уведомления не подписывает, поэтому это единственная проверка
# подлинности вебхука (плюс непредсказуемый путь ниже). Любая случайная строка:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
GCAL_WEBHOOK_TOKEN=
# Случайный сегмент пути: эндпоинт будет /webhook/gcal/<этот сегмент>
GCAL_WEBHOOK_PATH_SECRET=

# ------------------------------------------------------------------------------
#  Приём писем Preply (IMAP)
# ------------------------------------------------------------------------------
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
# Пароль приложения Google (16 символов), НЕ основной пароль от аккаунта:
# myaccount.google.com/apppasswords (нужна включённая двухфакторка).
IMAP_PASSWORD=
# Папка/метка, куда фильтр складывает письма Preply. Для Gmail метка = папка IMAP.
IMAP_FOLDER=Preply
# Отправитель, письма от которого считаются письмами Preply.
IMAP_ALLOWED_SENDERS=@preply.com
# Fallback-поллинг на случай, если IDLE-соединение отвалилось незаметно.
IMAP_POLL_INTERVAL_SEC=300
# IDLE-соединение принудительно переоткрывается с этим интервалом
# (серверы молча рвут долгие IDLE).
IMAP_IDLE_TIMEOUT_SEC=840

# ------------------------------------------------------------------------------
#  Preply: как занятость попадает на площадку
# ------------------------------------------------------------------------------
# false — нативная интеграция Preply ↔ Google Calendar НЕ подключена.
#         Сервис не может закрыть слот на Preply сам: на каждый частный урок
#         и каждый /block создаётся задача в очереди ручных действий, и бот
#         напоминает о ней, пока не подтвердишь кнопкой.
# true  — интеграция подключена (Preply → Calendar → Set up availability →
#         Google Calendar settings), занятость едет на площадку автоматически
#         с задержкой в несколько минут, очередь ручных задач выключена.
PREPLY_GCAL_LINKED=false

# Как часто напоминать о невыполненной ручной задаче.
MANUAL_TASK_REMIND_INTERVAL_MIN=30
# После стольких напоминаний задача перестаёт пинговать по отдельности
# и попадает в общую сводку «висит N задач» — чтобы не спамить.
MANUAL_TASK_MAX_REMINDERS=6

# Дублировать ли в календарь Buffers блоки, перекрывающие сами частные уроки.
# false — в Preply отмечаешь как busy-источник ДВА календаря: Private и Buffers.
# true  — отмечаешь только Buffers, но занятость дублируется в двух календарях.
PREPLY_BUSY_MIRROR=false

# ------------------------------------------------------------------------------
#  Правила бронирования
# ------------------------------------------------------------------------------
# Доступные длительности урока в минутах (через запятую).
LESSON_DURATIONS=30,60,90
# Сетка, по которой выравнивается начало слотов, минут.
SLOT_GRID_MINUTES=30
# Бронировать можно не раньше чем за столько часов от текущего момента.
MIN_NOTICE_HOURS=24
# Насколько вперёд открыто расписание, дней.
BOOKING_HORIZON_DAYS=30
# Отменить или перенести урок можно не позднее чем за столько часов до начала.
CANCEL_DEADLINE_HOURS=12
# Потолок уроков в сутки. 0 — без ограничения.
MAX_LESSONS_PER_DAY=0

# ------------------------------------------------------------------------------
#  Буферы
# ------------------------------------------------------------------------------
# Служебные блоки строго ДО и ПОСЛЕ урока, сам урок они не перекрывают.
BUFFER_BEFORE_MIN=10
BUFFER_AFTER_MIN=10

# ------------------------------------------------------------------------------
#  Напоминания ученику
# ------------------------------------------------------------------------------
# За сколько часов до урока напоминать (через запятую). Только частным ученикам —
# ученикам с Preply напоминания шлёт сама площадка.
REMINDER_HOURS_BEFORE=24,1

# ------------------------------------------------------------------------------
#  Фоновые задачи
# ------------------------------------------------------------------------------
# Полная сверка БД ↔ Google Calendar.
RECONCILE_INTERVAL_MIN=15
# Каналы events.watch живут ~7 дней; продлеваем заранее, за столько часов до конца.
GCAL_WATCH_RENEW_BEFORE_HOURS=24
# Если по каналу синхронизации не было успеха дольше этого времени — алерт.
STALE_CHANNEL_ALERT_MIN=60
# Столько ошибок подряд по одному каналу — алерт.
CONSECUTIVE_ERRORS_ALERT=3

# ------------------------------------------------------------------------------
#  Антифлуд в боте
# ------------------------------------------------------------------------------
RATE_LIMIT_MESSAGES=20
RATE_LIMIT_WINDOW_SEC=60

# ------------------------------------------------------------------------------
#  Хранение персональных данных
# ------------------------------------------------------------------------------
# Через сколько дней после завершения урок обезличивается. 0 — не чистить.
DATA_RETENTION_DAYS=730
